{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.test.{ts,mjs}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/extension": {
      "entry": [
        "src/adapters/index.ts",
        "src/test/smoke/**/*.smoke.test.ts",
        "cli/sandforge-*.ts",
        "cli/testing/*.ts"
      ],
      "project": ["src/**/*.ts", "cli/**/*.ts"]
    },
    "packages/webview": {
      "entry": [
        "src/main.sidepanel.tsx",
        "src/PanelApp.tsx",
        "src/i18n/sidepanelCatalogue.ts",
        "src/i18n/panelCatalogue.ts",
        "src/zodJitless.ts",
        "vite.config.e2e.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  },
  "rules": {
    "types": "off",
    "enumMembers": "off"
  },
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["vsce", "sf"],
  "ignoreDependencies": [
    "@vscode/vsce",
    "@axe-core/playwright",
    "@playwright/test",
    "@vscode/test-electron"
  ]
}
