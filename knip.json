{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.test.{ts,mjs}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/extension": {
      "entry": ["src/adapters/index.ts", "src/adapters/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "packages/webview": {
      "entry": ["src/main.sidepanel.tsx", "src/PanelApp.tsx", "vite.config.e2e.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "rules": {
    "types": "off",
    "enumMembers": "off"
  },
  "ignoreExportsUsedInFile": true,
  "ignore": ["packages/webview/e2e/quarantine/**"],
  "ignoreBinaries": ["vsce"],
  "ignoreDependencies": [
    "@types/.*",
    "@vitest/coverage-v8",
    "@vscode/vsce",
    "@axe-core/playwright",
    "@playwright/test"
  ]
}
