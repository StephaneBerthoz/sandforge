// SandForge — Jenkins Pipeline (EXAMPLE)
//
// Honest example built on what actually exists in this repo:
//   1. Quality gates   — pnpm validate (build:shared, typecheck, lint, tests, i18n, build)
//   2. Clone (dry-run) — packages/extension/cli/sandforge-clone.ts via tsx, its
//                        JSON summary saved to clone-summary.json
//   3. Removal (opt-in) — the same script with --remove clone-summary.json takes
//                        back what that clone created, and nothing else
//   4. VSIX package    — pnpm package, archived as an artifact
//
// There is no installed `sandforge` command: each headless tool is a script of
// packages/extension/cli/, run with tsx from a checkout. See ci-examples/README.md.
//
// Prerequisites:
//   - Node.js 24 configured in Jenkins Global Tool Configuration ('Node-24')
//   - Credentials (Secret text):
//     - sfdx-auth-url-source: sfdx auth URL of the source org
//     - sfdx-auth-url-target: sfdx auth URL of the target sandbox
//     - slack-webhook: (optional) Slack webhook for failure notifications
//   - To enable the Clone stage: set SANDFORGE_SF_ORGS=true in the job
//     environment (e.g. in folder properties) and pass SF_CLONE_RECORD_ID as a
//     build parameter; an environment variable of that name is ignored

pipeline {
    agent any

    tools {
        nodejs 'Node-24'
    }

    parameters {
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: true,
            description: 'Run the clone in dry-run mode (no data written to target org)'
        )
        booleanParam(
            name: 'REMOVE_AFTER',
            defaultValue: false,
            description: 'Once a real clone is done, remove the records it created at the end of the Clone stage'
        )
        booleanParam(
            name: 'ACCEPT_AUTOMATION',
            defaultValue: false,
            description: 'Clone for real although flows or Apex triggers of the target fire as the records are inserted'
        )
        string(
            name: 'SF_CLONE_RECORD_ID',
            defaultValue: '',
            description: 'Salesforce record Id to clone (e.g. 500...). Required for the Clone stage.'
        )
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    triggers {
        // Schedule: every Monday at 6 AM
        cron('0 6 * * 1')
    }

    stages {
        // ── Quality gates ──────────────────────────────────
        stage('Quality gates') {
            steps {
                // pnpm comes from the `packageManager` pin in package.json.
                sh 'corepack enable'
                sh 'pnpm install --frozen-lockfile'
                // Chains build:shared → typecheck → lint → test → check:i18n
                // → build. build:shared has to run first: the other packages
                // import @sandforge/shared from its dist/, so a bare
                // `pnpm typecheck` on a fresh checkout dies there. Split into
                // separate sh steps only with build:shared in front.
                sh 'pnpm validate'
            }
        }

        // ── Forge clone + removal (dry-run default) ────────
        stage('Clone (sandforge-clone)') {
            when {
                expression { return env.SANDFORGE_SF_ORGS == 'true' && params.SF_CLONE_RECORD_ID?.trim() }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'sfdx-auth-url-source', variable: 'SFDX_AUTH_URL_SOURCE'),
                    string(credentialsId: 'sfdx-auth-url-target', variable: 'SFDX_AUTH_URL_TARGET')
                ]) {
                    sh 'npm install -g @salesforce/cli'
                    sh 'pnpm build:shared'
                    // Authenticate both orgs; the CLIs shell out to `sf org display`.
                    // One `sh` for the whole sequence: each `sh` is its own shell,
                    // and the trap that removes the URLs only covers the shell that
                    // set it. Agents keep /tmp between builds, failed logins included.
                    sh '''
                        umask 077
                        auth_dir=$(mktemp -d)
                        trap 'rm -rf "$auth_dir"' EXIT
                        printf '%s' "$SFDX_AUTH_URL_SOURCE" > "$auth_dir/source.txt"
                        printf '%s' "$SFDX_AUTH_URL_TARGET" > "$auth_dir/target.txt"
                        sf org login sfdxurl --sfdx-url-file "$auth_dir/source.txt" --alias ci-source
                        sf org login sfdxurl --sfdx-url-file "$auth_dir/target.txt" --alias ci-target
                    '''
                    script {
                        def dryRunFlag = params.DRY_RUN ? '--dry-run' : ''
                        def automationFlag = params.ACCEPT_AUTOMATION ? '--accept-automation' : ''
                        sh """
                            pnpm exec tsx packages/extension/cli/sandforge-clone.ts \\
                                --record "${params.SF_CLONE_RECORD_ID}" \\
                                --source ci-source \\
                                --target ci-target \\
                                --upsert \\
                                ${dryRunFlag} \\
                                ${automationFlag} \\
                                --json \\
                                --remap-csv remap.csv \\
                                --audit clone-audit.json \\
                                > clone-summary.json
                        """
                        // Your checks against the cloned records go here.

                        // Takes back what the clone created, from the summary
                        // it saved: never a record the target already held,
                        // and not one changed since the clone (add
                        // --include-changed when your checks change them). A
                        // dry run created nothing and its summary is refused,
                        // so this runs after a real clone only. It stays in
                        // the stage that logged in: on a persistent agent, a
                        // stage of its own would act on whatever `ci-target`
                        // an earlier build left. What the removal wrote to the
                        // records it kept goes to clone-summary.removals.json,
                        // which a later --remove of the same summary reads:
                        // both are archived.
                        if (!params.DRY_RUN && params.REMOVE_AFTER) {
                            sh '''
                                pnpm exec tsx packages/extension/cli/sandforge-clone.ts \\
                                    --remove clone-summary.json \\
                                    --target ci-target \\
                                    --json \\
                                    --audit clone-audit.json \\
                                    > clone-removal.json
                            '''
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'clone-summary.json, clone-summary.removals.json, clone-removal.json, clone-audit.json, remap.csv', allowEmptyArchive: true
                }
            }
        }

        // ── VSIX package ───────────────────────────────────
        stage('Package VSIX') {
            steps {
                sh 'pnpm package'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'sandforge.vsix', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        // Notify on failure via Slack (if webhook is configured)
        failure {
            script {
                try {
                    withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_WEBHOOK_URL')]) {
                        sh """
                            curl -X POST "\$SLACK_WEBHOOK_URL" \\
                                -H 'Content-Type: application/json' \\
                                -d '{"text": "SandForge Pipeline FAILED on ${env.JOB_NAME} (#${env.BUILD_NUMBER}) — ${env.BUILD_URL}"}'
                        """
                    }
                } catch (Exception e) {
                    echo "Slack notification skipped: ${e.message}"
                }
            }
        }

        // Log the CI aliases out and clean up the workspace. A persistent agent
        // keeps the sf CLI's auth store between builds, so a session left
        // behind would outlive the credentials rotated in Jenkins.
        cleanup {
            sh '''
                sf org logout --target-org ci-source --no-prompt || true
                sf org logout --target-org ci-target --no-prompt || true
            '''
            cleanWs()
        }
    }
}
