// SandForge — Jenkins Pipeline (EXAMPLE)
//
// Honest example built on what actually exists in this repo:
//   1. Quality gates   — pnpm validate (build:shared, typecheck, lint, tests, i18n, build)
//   2. Clone (dry-run) — packages/extension/cli/sandforge-clone.ts via tsx
//   3. Cleanup (dry-run) — packages/extension/cli/sandforge-cleanup.ts via tsx
//   4. VSIX package    — pnpm package, archived as an artifact
//
// There is NO `sandforge seed|sync|backup|health` CLI — those stages exist
// only in the VSCode extension UI. See ci-examples/README.md for details.
//
// Prerequisites:
//   - Node.js 20 configured in Jenkins Global Tool Configuration ('Node-20')
//   - Credentials (Secret text):
//     - sfdx-auth-url-source: sfdx auth URL of the source org
//     - sfdx-auth-url-target: sfdx auth URL of the target sandbox
//     - slack-webhook: (optional) Slack webhook for failure notifications
//   - Job environment: set SANDFORGE_SF_ORGS=true and SF_CLONE_RECORD_ID
//     (e.g. in folder properties) to enable the clone/cleanup stages

pipeline {
    agent any

    tools {
        nodejs 'Node-22'
    }

    parameters {
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: true,
            description: 'Run clone/cleanup in dry-run mode (no data written to target org)'
        )
        string(
            name: 'SF_CLONE_RECORD_ID',
            defaultValue: '',
            description: 'Salesforce record Id to clone (e.g. 500...). Required for the Clone stage.'
        )
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    triggers {
        // Schedule: every Monday at 6 AM
        cron('0 6 * * 1')
    }

    stages {
        // ── Quality gates ──────────────────────────────────
        stage('Quality gates') {
            steps {
                sh 'npm install -g pnpm@11'
                sh 'pnpm install --frozen-lockfile'
                // Chains build:shared → typecheck → lint → test → check:i18n
                // → build. build:shared has to run first: the other packages
                // import @sandforge/shared from its dist/, so a bare
                // `pnpm typecheck` on a fresh checkout dies there. Split into
                // separate sh steps only with build:shared in front.
                sh 'pnpm validate'
            }
        }

        // ── Forge clone (real CLI, dry-run default) ────────
        stage('Clone (sandforge-clone)') {
            when {
                expression { return env.SANDFORGE_SF_ORGS == 'true' && params.SF_CLONE_RECORD_ID?.trim() }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'sfdx-auth-url-source', variable: 'SFDX_AUTH_URL_SOURCE'),
                    string(credentialsId: 'sfdx-auth-url-target', variable: 'SFDX_AUTH_URL_TARGET')
                ]) {
                    sh 'npm install -g @salesforce/cli'
                    sh 'pnpm build:shared'
                    // Authenticate both orgs; the CLIs shell out to `sf org display`.
                    sh 'printf "%s" "$SFDX_AUTH_URL_SOURCE" > /tmp/auth-source.txt'
                    sh 'printf "%s" "$SFDX_AUTH_URL_TARGET" > /tmp/auth-target.txt'
                    sh 'sf org login sfdxurl --sfdx-url-file /tmp/auth-source.txt --alias ci-source'
                    sh 'sf org login sfdxurl --sfdx-url-file /tmp/auth-target.txt --alias ci-target'
                    sh 'rm -f /tmp/auth-source.txt /tmp/auth-target.txt'
                    script {
                        def dryRunFlag = params.DRY_RUN ? '--dry-run' : ''
                        sh """
                            pnpm exec tsx packages/extension/cli/sandforge-clone.ts \\
                                --record "${params.SF_CLONE_RECORD_ID}" \\
                                --source ci-source \\
                                --target ci-target \\
                                --upsert \\
                                ${dryRunFlag} \\
                                --json \\
                                --remap-csv remap.csv \\
                                > clone-summary.json
                        """
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'clone-summary.json, remap.csv', allowEmptyArchive: true
                }
            }
        }

        // ── Cleanup (real CLI, dry-run default) ────────────
        stage('Cleanup (sandforge-cleanup)') {
            when {
                expression { return env.SANDFORGE_SF_ORGS == 'true' }
            }
            steps {
                script {
                    def dryRunFlag = params.DRY_RUN ? '--dry-run' : ''
                    sh """
                        pnpm exec tsx packages/extension/cli/sandforge-cleanup.ts \\
                            --target ci-target \\
                            --since today \\
                            ${dryRunFlag}
                    """
                }
            }
        }

        // ── VSIX package ───────────────────────────────────
        stage('Package VSIX') {
            steps {
                sh 'pnpm package'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'sandforge.vsix', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        // Notify on failure via Slack (if webhook is configured)
        failure {
            script {
                try {
                    withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_WEBHOOK_URL')]) {
                        sh """
                            curl -X POST "\$SLACK_WEBHOOK_URL" \\
                                -H 'Content-Type: application/json' \\
                                -d '{"text": "SandForge Pipeline FAILED on ${env.JOB_NAME} (#${env.BUILD_NUMBER}) — ${env.BUILD_URL}"}'
                        """
                    }
                } catch (Exception e) {
                    echo "Slack notification skipped: ${e.message}"
                }
            }
        }

        // Clean up workspace
        cleanup {
            cleanWs()
        }
    }
}
