{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": { "type": "number", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "description": { "type": "string", "maxLength": 2000 },
    "targets": {
      "default": {},
      "type": "object",
      "properties": {
        "kinds": {
          "default": ["scratch", "developer"],
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": { "type": "string", "enum": ["scratch", "developer", "sandbox"] }
        },
        "sandboxes": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": { "type": "string", "pattern": "^00D[A-Za-z0-9]{12}(?:[A-Za-z0-9]{3})?$" }
        },
        "protect": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": { "type": "string", "pattern": "^00D[A-Za-z0-9]{12}(?:[A-Za-z0-9]{3})?$" }
        }
      },
      "additionalProperties": false
    },
    "orgs": {
      "default": {},
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "alias": {
            "anyOf": [
              { "type": "string", "pattern": "^[^-\\s][^\\s]{0,199}$" },
              {
                "type": "object",
                "properties": {
                  "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" }
                },
                "required": ["env"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["alias"],
        "additionalProperties": false
      }
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "before": { "type": "boolean" },
        "after": {
          "anyOf": [
            { "type": "boolean", "const": false },
            { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
          ]
        },
        "ignoreFields": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 161,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "masking": {
      "default": {},
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rules": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fieldPattern": {
                  "type": "string",
                  "maxLength": 170,
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$"
                },
                "ruleType": {
                  "type": "string",
                  "enum": [
                    "fake",
                    "mask",
                    "hash",
                    "nullify",
                    "shuffle",
                    "preserve_format",
                    "constant",
                    "truncate"
                  ]
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "constantValue": { "type": "string", "maxLength": 255 },
                    "maskKeepLast": { "type": "integer", "minimum": 0, "maximum": 255 },
                    "truncateLength": { "type": "integer", "minimum": 1, "maximum": 255 },
                    "truncateKeep": { "type": "string", "enum": ["first", "last"] }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["fieldPattern", "ruleType"],
              "additionalProperties": false
            }
          }
        },
        "required": ["rules"],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "seed" },
              "dependsOn": {
                "maxItems": 50,
                "type": "array",
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
              },
              "accept": {
                "type": "object",
                "properties": { "automation": { "type": "boolean" } },
                "additionalProperties": false
              },
              "template": { "type": "string", "minLength": 1, "maxLength": 200 },
              "objects": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                    },
                    "count": { "type": "integer", "exclusiveMinimum": 0, "maximum": 1000000 },
                    "fields": {
                      "maxItems": 500,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "fieldApiName": { "type": "string", "minLength": 1 },
                          "fieldType": { "type": "string", "minLength": 1 },
                          "ruleType": {
                            "type": "string",
                            "enum": [
                              "static",
                              "random",
                              "sequence",
                              "formula",
                              "reference",
                              "picklist_random",
                              "ai_generate",
                              "faker",
                              "regex",
                              "from_csv"
                            ]
                          },
                          "config": {
                            "type": "object",
                            "properties": {
                              "staticValue": { "type": ["string", "number", "boolean"] },
                              "fakerMethod": { "type": "string" },
                              "fakerLocale": { "type": "string" },
                              "sequenceStart": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "sequenceStep": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "sequencePrefix": { "type": "string" },
                              "formula": { "type": "string" },
                              "referenceObject": { "type": "string" },
                              "referenceField": { "type": "string" },
                              "picklistValues": { "type": "array", "items": { "type": "string" } },
                              "regexPattern": { "type": "string" },
                              "csvColumn": { "type": "string" },
                              "minValue": { "type": "number" },
                              "maxValue": { "type": "number" },
                              "minLength": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "maxLength": {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              "aiPrompt": { "type": "string" }
                            },
                            "additionalProperties": false
                          }
                        },
                        "required": ["fieldApiName", "ruleType", "config"],
                        "additionalProperties": false
                      }
                    },
                    "recordTypes": {
                      "minItems": 1,
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 80,
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                      }
                    },
                    "batchSize": { "type": "integer", "exclusiveMinimum": 0, "maximum": 10000 }
                  },
                  "required": ["object", "count"],
                  "additionalProperties": false
                }
              },
              "relations": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "lookup": {
                      "type": "string",
                      "maxLength": 161,
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$"
                    },
                    "parents": {
                      "type": "object",
                      "properties": {
                        "object": {
                          "type": "string",
                          "maxLength": 80,
                          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                        },
                        "existing": {
                          "type": "object",
                          "properties": {
                            "where": { "type": "string", "minLength": 1, "maxLength": 2000 },
                            "limit": { "type": "integer", "exclusiveMinimum": 0, "maximum": 2000 }
                          },
                          "required": ["limit"],
                          "additionalProperties": false
                        },
                        "from": {
                          "type": "string",
                          "maxLength": 144,
                          "pattern": "^[a-z][a-z0-9-]{0,62}(?:\\.[A-Za-z][A-Za-z0-9_]*)?$"
                        },
                        "limit": { "type": "integer", "exclusiveMinimum": 0, "maximum": 2000 }
                      },
                      "additionalProperties": false
                    },
                    "distribution": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "mode": { "type": "string", "const": "perParent" },
                            "count": { "type": "integer", "exclusiveMinimum": 0, "maximum": 1000 }
                          },
                          "required": ["mode", "count"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "mode": { "type": "string", "const": "range" },
                            "min": { "type": "integer", "minimum": 0, "maximum": 1000 },
                            "max": { "type": "integer", "exclusiveMinimum": 0, "maximum": 1000 }
                          },
                          "required": ["mode", "min", "max"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "mode": { "type": "string", "const": "ratio" },
                            "ratio": { "type": "number", "minimum": 0.01, "maximum": 1000 }
                          },
                          "required": ["mode", "ratio"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": ["lookup", "parents", "distribution"],
                  "additionalProperties": false
                }
              },
              "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:_[A-Za-z0-9]{2,4}){0,2}$" },
              "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "forge" },
              "dependsOn": {
                "maxItems": 50,
                "type": "array",
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
              },
              "accept": {
                "type": "object",
                "properties": {
                  "automation": { "type": "boolean" },
                  "realData": { "type": "boolean" }
                },
                "additionalProperties": false
              },
              "source": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
              "record": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "pattern": "^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$" },
                  "object": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                  },
                  "where": { "type": "string", "minLength": 1, "maxLength": 512 }
                },
                "additionalProperties": false
              },
              "tables": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                    },
                    "where": { "type": "string", "minLength": 1, "maxLength": 512 }
                  },
                  "required": ["object"],
                  "additionalProperties": false
                }
              },
              "template": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "id": { "type": "string", "minLength": 1, "maxLength": 200 }
                },
                "required": ["file", "id"],
                "additionalProperties": false
              },
              "depth": { "type": "string", "enum": ["direct", "full", "custom"] },
              "customDepth": { "type": "integer", "exclusiveMinimum": 0, "maximum": 10 },
              "maxNodes": { "type": "integer", "minimum": 10, "maximum": 500 },
              "anonymize": {
                "type": "object",
                "properties": {
                  "presetId": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "rules": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "enum": ["email", "phone", "name", "address", "ssn_id", "financial", "other"]
                    },
                    "additionalProperties": {
                      "type": "string",
                      "enum": [
                        "fake",
                        "mask",
                        "hash",
                        "nullify",
                        "redact",
                        "shuffle",
                        "truncate",
                        "preserve_format",
                        "age_band",
                        "generalize"
                      ]
                    }
                  },
                  "fields": {
                    "maxItems": 2000,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "objectApiName": {
                          "type": "string",
                          "maxLength": 80,
                          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                        },
                        "fieldNames": {
                          "maxItems": 500,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 80,
                            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                          }
                        }
                      },
                      "required": ["objectApiName", "fieldNames"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["rules"],
                "additionalProperties": false
              },
              "keepContactPoints": { "type": "boolean" },
              "maxTotal": { "type": "integer", "exclusiveMinimum": 0, "maximum": 1000000 }
            },
            "required": ["kind", "source"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "frozen" },
              "dependsOn": {
                "maxItems": 50,
                "type": "array",
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
              },
              "accept": {
                "type": "object",
                "properties": { "automation": { "type": "boolean" } },
                "additionalProperties": false
              },
              "config": { "type": "string", "minLength": 1, "maxLength": 500 },
              "dataset": {
                "type": "object",
                "properties": {
                  "path": {
                    "anyOf": [
                      { "type": "string", "minLength": 1, "maxLength": 4096 },
                      {
                        "type": "object",
                        "properties": {
                          "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" }
                        },
                        "required": ["env"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
                  "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                },
                "required": ["path", "version", "digest"],
                "additionalProperties": false
              }
            },
            "required": ["kind", "config", "dataset"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "const": "mask" },
              "dependsOn": {
                "maxItems": 50,
                "type": "array",
                "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
              },
              "accept": {
                "type": "object",
                "properties": { "automation": { "type": "boolean" } },
                "additionalProperties": false
              },
              "rules": {
                "anyOf": [
                  { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
                  {
                    "type": "object",
                    "properties": {
                      "template": { "type": "string", "pattern": "^tpl-[a-z0-9-]{1,60}$" }
                    },
                    "required": ["template"],
                    "additionalProperties": false
                  }
                ]
              },
              "object": { "type": "string", "maxLength": 80, "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
              "where": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "required": ["kind", "rules"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["version", "name", "resources"],
  "additionalProperties": false
}
