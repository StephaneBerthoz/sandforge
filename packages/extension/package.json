{
  "name": "sandforge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.21.0",
  "publisher": "StephaneBerthoz",
  "author": {
    "name": "Stephane Berthoz"
  },
  "license": "MIT",
  "preview": false,
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },
  "badges": [
    {
      "href": "https://marketplace.visualstudio.com/items?itemName=StephaneBerthoz.sandforge",
      "url": "https://img.shields.io/badge/version-1.21.0-blue",
      "description": "Marketplace version"
    },
    {
      "href": "https://github.com/StephaneBerthoz/sandforge/actions/workflows/ci.yml",
      "url": "https://github.com/StephaneBerthoz/sandforge/actions/workflows/ci.yml/badge.svg",
      "description": "CI status"
    }
  ],
  "qna": "https://github.com/StephaneBerthoz/sandforge/discussions",
  "repository": {
    "type": "git",
    "url": "https://github.com/StephaneBerthoz/sandforge"
  },
  "homepage": "https://github.com/StephaneBerthoz/sandforge#readme",
  "bugs": {
    "url": "https://github.com/StephaneBerthoz/sandforge/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Testing",
    "Visualization"
  ],
  "keywords": [
    "salesforce",
    "sandbox",
    "test data",
    "seed data",
    "data masking",
    "data migration",
    "data import",
    "data seeding",
    "data sync",
    "org cloning",
    "sandbox seeding",
    "anonymization",
    "anonymize",
    "sfdc",
    "sfdx",
    "sfdmu",
    "data loader",
    "devops",
    "etl",
    "bulk api",
    "soql",
    "apex",
    "flow",
    "metadata",
    "gdpr",
    "backup",
    "monitoring",
    "csv",
    "pii"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sandforge",
          "title": "%viewContainer.title%",
          "icon": "resources/icons/toolkit.svg"
        }
      ]
    },
    "views": {
      "sandforge": [
        {
          "type": "webview",
          "id": "sandforge.sidebarView",
          "name": "%view.launcher%"
        }
      ]
    },
    "commands": [
      {
        "command": "sandforge.openMonitor",
        "title": "%command.openMonitor%",
        "icon": "$(dashboard)"
      },
      {
        "command": "sandforge.openSeed",
        "title": "%command.openSeed%",
        "icon": "$(database)"
      },
      {
        "command": "sandforge.openSync",
        "title": "%command.openSync%",
        "icon": "$(sync)"
      },
      {
        "command": "sandforge.openForge",
        "title": "%command.openForge%",
        "icon": "$(flame)"
      },
      {
        "command": "sandforge.openFrozen",
        "title": "%command.openFrozen%",
        "icon": "$(snowflake)"
      },
      {
        "command": "sandforge.openGrappe",
        "title": "%command.openGrappe%",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "sandforge.openAutopilot",
        "title": "%command.openAutopilot%",
        "icon": "$(rocket)"
      },
      {
        "command": "sandforge.openCompare",
        "title": "%command.openCompare%",
        "icon": "$(diff)"
      },
      {
        "command": "sandforge.openDataOps",
        "title": "%command.openDataOps%",
        "icon": "$(shield)"
      },
      {
        "command": "sandforge.openAutomation",
        "title": "%command.openAutomation%",
        "icon": "$(zap)"
      },
      {
        "command": "sandforge.openMigration",
        "title": "%command.openMigration%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "sandforge.openAI",
        "title": "%command.openAI%",
        "icon": "$(hubot)"
      },
      {
        "command": "sandforge.openOrgs",
        "title": "%command.openOrgs%",
        "icon": "$(plug)"
      },
      {
        "command": "sandforge.openReports",
        "title": "%command.openReports%",
        "icon": "$(graph)"
      },
      {
        "command": "sandforge.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "sandforge.openHelp",
        "title": "%command.openHelp%",
        "icon": "$(question)"
      },
      {
        "command": "sandforge.cheers",
        "title": "%command.cheers%",
        "icon": "$(sparkle)"
      },
      {
        "command": "sandforge.openOrgInBrowser",
        "title": "%command.openOrgInBrowser%",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sandforge.openOrgInBrowser",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sandforge.openGrappe",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeViewlet == 'workbench.view.extension.sandforge'"
      },
      {
        "command": "sandforge.openAutomation",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "activeViewlet == 'workbench.view.extension.sandforge'"
      }
    ],
    "walkthroughs": [
      {
        "id": "sandforge.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "sandforge.connectOrg",
            "title": "%walkthrough.step.connectOrg.title%",
            "description": "%walkthrough.step.connectOrg.description%",
            "media": {
              "markdown": "walkthrough/connect-org.md"
            },
            "completionEvents": [
              "onCommand:sandforge.openOrgs"
            ]
          },
          {
            "id": "sandforge.forgeClone",
            "title": "%walkthrough.step.forgeClone.title%",
            "description": "%walkthrough.step.forgeClone.description%",
            "media": {
              "markdown": "walkthrough/forge-clone.md"
            },
            "completionEvents": [
              "onCommand:sandforge.openForge"
            ]
          },
          {
            "id": "sandforge.monitorLimits",
            "title": "%walkthrough.step.monitorLimits.title%",
            "description": "%walkthrough.step.monitorLimits.description%",
            "media": {
              "markdown": "walkthrough/monitor-limits.md"
            },
            "completionEvents": [
              "onCommand:sandforge.openMonitor"
            ]
          },
          {
            "id": "sandforge.exploreSettings",
            "title": "%walkthrough.step.exploreSettings.title%",
            "description": "%walkthrough.step.exploreSettings.description%",
            "media": {
              "markdown": "walkthrough/settings.md"
            },
            "completionEvents": [
              "onCommand:sandforge.openSettings"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "sandforge.telemetry": {
          "type": "boolean",
          "default": false,
          "description": "%config.telemetry.description%"
        },
        "sandforge.orgs.validateOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.orgs.validateOnStartup.description%"
        },
        "sandforge.seed.defaultBatchSize": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 10000,
          "description": "%config.seed.defaultBatchSize.description%"
        },
        "sandforge.sync.defaultBatchSize": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 10000,
          "description": "%config.sync.defaultBatchSize.description%"
        },
        "sandforge.sync.maxConcurrentOps": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "%config.sync.maxConcurrentOps.description%"
        },
        "sandforge.ai.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.ai.enabled.description%"
        },
        "sandforge.ai.provider": {
          "type": "string",
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "custom"
          ],
          "description": "%config.ai.provider.description%"
        },
        "sandforge.ai.model": {
          "type": "string",
          "default": "claude-sonnet-4-5-20250929",
          "description": "%config.ai.model.description%"
        },
        "sandforge.ai.tokenBudgetMaxPerSession": {
          "type": "number",
          "default": 50000,
          "minimum": 1000,
          "maximum": 1000000,
          "description": "%config.ai.tokenBudgetMaxPerSession.description%"
        },
        "sandforge.backup.maxCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.backup.maxCount.description%"
        },
        "sandforge.pipeline.timeout": {
          "type": "number",
          "default": 300000,
          "minimum": 30000,
          "maximum": 3600000,
          "description": "%config.pipeline.timeout.description%"
        },
        "sandforge.safety.requireProdConfirmation": {
          "type": "boolean",
          "default": true,
          "description": "%config.safety.requireProdConfirmation.description%"
        },
        "sandforge.safety.auditLogging": {
          "type": "boolean",
          "default": true,
          "description": "%config.safety.auditLogging.description%"
        },
        "sandforge.grappe.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.grappe.enabled.description%"
        },
        "sandforge.grappe.autoActivateThreshold": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "description": "%config.grappe.autoActivateThreshold.description%"
        },
        "sandforge.grappe.grappeSize": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "%config.grappe.grappeSize.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm run clean && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:@anthropic-ai/sdk \"--external:@anthropic-ai/sdk/*\" --external:./jsforceEntry.js --format=cjs --platform=node --sourcemap=external --minify && esbuild ./src/core/connection/jsforceEntry.ts --bundle --outfile=dist/jsforceEntry.js --format=cjs --platform=node --minify && node ../../scripts/vendor-ai-sdk.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.93.0",
    "@sandforge/shared": "workspace:*",
    "cron-parser": "^5.5.0",
    "jsforce": "^3",
    "p-limit": "^3.1.0",
    "pino": "^9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.95",
    "@vitest/coverage-v8": "^3",
    "@vscode/vsce": "^3",
    "esbuild": "^0.21",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
