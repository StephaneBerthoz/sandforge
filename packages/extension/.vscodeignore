# Source files
src/**
**/*.test.ts
**/*.test.tsx
**/*.spec.ts

# Config files
**/vitest.config.ts
**/tsconfig.json
**/tsconfig*.json
.eslintrc*
.prettierrc*
esbuild.config.*

# Build artifacts to exclude
coverage/
**/*.map
**/*.d.ts

# What a tsc emit of src/ leaves in dist/ (tsconfig.json's outDir). The VSIX
# runs dist/extension.js, esbuild's bundle of src/, which loads jsforce from
# dist/jsforceEntry.js and the AI SDK vendored into dist/node_modules/.
dist/adapters/**
dist/bridge/**
dist/composition/**
dist/core/**
dist/modules/**
dist/providers/**
dist/test/**
dist/logger.js
dist/services.js

# Package manager
node_modules/**
pnpm-lock.yaml

# Documentation (lives in repo, not VSIX)
docs/
assets/screenshots/

# CI/CD
.github/
scripts/
.planning/

# Dev configs
.editorconfig
phases/
plans/
prompts/
test/

# Dev/tool files
.claude/
.serena/
.vscode/
.omc/
**/.gitignore
CLAUDE.md

# Dev/CI utilities, run from the repo through tsx. No build entry point
# reaches them, so nothing here is in dist/extension.js either.
cli/
tools/
examples/
# The smoke suite and its runner. `test/` above covers the TypeScript sources;
# these are the compiled output and the @vscode/test-cli config, which landed in
# the 1.23.0 VSIX and were installed on every user's machine.
out-smoke/
.vscode-test.mjs
.vscode-test/
