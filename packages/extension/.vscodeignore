**/*.test.tsx
**/*.spec.ts

# Config files
**/vitest.config.ts
**/tsconfig.json
**/tsconfig*.json
.eslintrc*
.prettierrc*
esbuild.config.*

# Build artifacts to exclude
coverage/
**/*.map
**/*.d.ts

