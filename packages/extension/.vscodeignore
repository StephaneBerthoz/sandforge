dist/bridge/**
dist/core/**
dist/modules/**
dist/providers/**
dist/logger.js

# Package manager
node_modules/**
pnpm-lock.yaml

# Documentation (lives in repo, not VSIX)
docs/
assets/screenshots/

# CI/CD
.github/
scripts/
.planning/

# Dev configs
.editorconfig
phases/
plans/
prompts/
test/

# Dev/tool files
.claude/
.serena/
.vscode/
.omc/
**/.gitignore
CLAUDE.md

