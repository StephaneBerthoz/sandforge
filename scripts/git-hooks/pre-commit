#!/usr/bin/env bash
# Pre-commit guard — closes two silent-regression gaps that the extension
# test suite cannot see on its own:
#
# (1) Webview typecheck. `pnpm test` runs the extension vitest suite only, so
# a webview-only type error stays green there — e.g. an `ai:provider:status` /
# `ai:budget:state` envelope inlined as an ad-hoc type missing BaseMessage's
# id + timestamp fields. `pnpm package` is the only other path that runs the
# webview tsc, and it is not run on every commit. `pnpm -r typecheck` runs
# tsc per package.
#
# (2) Duplicate keys in i18n locale JSONs. A locale file carrying the same key
# twice (monitor / dataops / execution have all done it) parses without
# complaint — JSON.parse keeps the second value and wipes out an entire
# module's translations, so the UI renders raw keys such as
# `monitor.emptyState.title` instead of the label. Typecheck does NOT catch
# this: the JSON imports pass even with dupes. `pnpm check:i18n` scans every
# webview locale and package.nls file at any depth; CI runs the same gate, so
# a commit made with --no-verify is caught there.
#
# Bypass with --no-verify if you really need to (don't).

set -e

echo "→ pre-commit: pnpm -r typecheck"
pnpm -r typecheck

echo "→ pre-commit: pnpm check:i18n"
pnpm check:i18n

echo "✓ pre-commit: typecheck + i18n gate green"
