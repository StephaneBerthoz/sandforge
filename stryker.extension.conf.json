{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "packages/extension/vitest.config.ts",
    "dir": "packages/extension"
  },
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutate": ["packages/extension/src/core/engine/**/*.ts", "!**/*.test.ts"],
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": { "fileName": "reports/mutation/extension/mutation.html" },
  "jsonReporter": { "fileName": "reports/mutation/extension/mutation.json" },
  "thresholds": { "high": 80, "low": 60, "break": 69 },
  "timeoutMS": 30000,
  "timeoutFactor": 2,
  "concurrency": 4,
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental-extension.json",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "logLevel": "info"
}
