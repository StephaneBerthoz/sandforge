{
  "_description": "SandForge team configuration file. Copy this to .sandforge.json and customize for your team.",

  "team": {
    "_description": "Team and project identification",
    "name": "My Salesforce Team",
    "project": "CRM Implementation",
    "environment": "development",
    "defaultLanguage": "en",
    "members": [
      {
        "name": "Admin User",
        "email": "admin@example.com",
        "role": "admin"
      },
      {
        "name": "Developer User",
        "email": "dev@example.com",
        "role": "developer"
      }
    ]
  },

  "orgs": {
    "_description": "Salesforce org connections. Credentials are stored securely in VSCode secret storage, not here.",
    "source": {
      "alias": "dev-sandbox",
      "loginUrl": "https://test.salesforce.com",
      "apiVersion": "60.0",
      "type": "sandbox",
      "description": "Development sandbox for data seeding and testing"
    },
    "target": {
      "alias": "qa-sandbox",
      "loginUrl": "https://test.salesforce.com",
      "apiVersion": "60.0",
      "type": "sandbox",
      "description": "QA sandbox for integration testing"
    },
    "production": {
      "alias": "production",
      "loginUrl": "https://login.salesforce.com",
      "apiVersion": "60.0",
      "type": "production",
      "description": "Production org — read-only operations allowed",
      "readOnly": true
    }
  },

  "seed": {
    "_description": "Default seed configuration for generating test data",
    "defaultTemplate": "standard-crm",
    "defaultBatchSize": 200,
    "defaultStrategy": "faker",
    "aiProvider": "openai",
    "aiModel": "gpt-4",
    "maxRecordsPerRun": 10000,
    "previewSampleSize": 5,
    "templates": [
      {
        "name": "standard-crm",
        "description": "Standard CRM data: Accounts, Contacts, Opportunities",
        "objects": [
          {
            "objectApiName": "Account",
            "recordCount": 100,
            "insertOrder": 1
          },
          {
            "objectApiName": "Contact",
            "recordCount": 300,
            "insertOrder": 2
          },
          {
            "objectApiName": "Opportunity",
            "recordCount": 200,
            "insertOrder": 3
          }
        ]
      },
      {
        "name": "minimal",
        "description": "Minimal test data for quick iterations",
        "objects": [
          {
            "objectApiName": "Account",
            "recordCount": 10,
            "insertOrder": 1
          },
          {
            "objectApiName": "Contact",
            "recordCount": 20,
            "insertOrder": 2
          }
        ]
      }
    ]
  },

  "sync": {
    "_description": "Default sync configuration for data synchronization between orgs",
    "defaultBatchSize": 200,
    "defaultConflictStrategy": "source_wins",
    "defaultExternalIdField": "Id",
    "enableIncrementalTracking": true,
    "maxConcurrentJobs": 3,
    "defaultDirection": "source_to_target",
    "defaultMode": "full",
    "objects": [
      {
        "objectApiName": "Account",
        "operation": "upsert",
        "externalIdField": "Account_External_Id__c",
        "batchSize": 200,
        "insertOrder": 1,
        "excludedFields": ["OwnerId", "CreatedDate", "LastModifiedDate"]
      },
      {
        "objectApiName": "Contact",
        "operation": "upsert",
        "externalIdField": "Contact_External_Id__c",
        "batchSize": 200,
        "insertOrder": 2,
        "excludedFields": ["OwnerId", "CreatedDate", "LastModifiedDate"]
      },
      {
        "objectApiName": "Opportunity",
        "operation": "upsert",
        "externalIdField": "Opportunity_External_Id__c",
        "batchSize": 200,
        "insertOrder": 3,
        "excludedFields": ["OwnerId", "CreatedDate", "LastModifiedDate", "StageName"]
      }
    ]
  },

  "automation": {
    "_description": "Pipeline automation settings for scheduled and triggered operations",
    "pipelines": [
      {
        "name": "nightly-sync",
        "description": "Nightly data sync from dev to QA",
        "enabled": true,
        "trigger": {
          "type": "schedule",
          "cron": "0 2 * * *",
          "timezone": "America/New_York"
        },
        "steps": [
          { "type": "precheck", "name": "Verify connections" },
          { "type": "backup", "name": "Backup QA data" },
          { "type": "sync", "name": "Sync dev to QA" },
          { "type": "notification", "name": "Notify team" }
        ]
      },
      {
        "name": "post-refresh-seed",
        "description": "Re-seed sandbox after Salesforce refresh",
        "enabled": false,
        "trigger": {
          "type": "sandbox_refresh"
        },
        "steps": [
          { "type": "seed", "name": "Seed test data" },
          { "type": "sync", "name": "Sync reference data" },
          { "type": "notification", "name": "Notify team" }
        ]
      }
    ]
  },

  "grappe": {
    "_description": "Grappe (cluster/parallel) processing configuration for large data volumes",
    "autoActivate": true,
    "autoActivateThreshold": 5000,
    "maxWorkers": 4,
    "defaultGrappeSize": 1000,
    "defaultStrategy": "by_volume",
    "backPressure": {
      "enabled": true,
      "highWaterMark": 80,
      "lowWaterMark": 40,
      "strategy": "throttle"
    },
    "checkpointing": true
  },

  "security": {
    "_description": "Security and compliance settings",
    "requireConfirmationForProduction": true,
    "auditLogging": true,
    "sensitiveDataDetection": true,
    "allowedOperationsOnProd": ["compare", "monitor"],
    "fieldLevelSecurity": {
      "respectFLS": true,
      "maskSensitiveFields": true,
      "sensitiveFieldPatterns": [
        "*SSN*", "*Social_Security*", "*Tax_Id*",
        "*Credit_Card*", "*Password*", "*Secret*"
      ]
    },
    "dataRetention": {
      "backupRetentionDays": 30,
      "logRetentionDays": 90,
      "reportRetentionDays": 365
    }
  },

  "migration": {
    "_description": "Settings for importing configurations from other tools",
    "sfdmu": {
      "defaultExportPath": "./sfdmu-export",
      "autoMapFields": true
    },
    "gearset": {
      "defaultReportPath": "./gearset-reports",
      "includeUnchanged": false
    },
    "universal": {
      "defaultDelimiter": ",",
      "defaultOperation": "upsert",
      "autoDetectTypes": true
    }
  },

  "telemetry": {
    "_description": "Anonymous, opt-in usage telemetry. No personal data is collected.",
    "enabled": false,
    "batchSize": 50,
    "sendIntervalMinutes": 60
  },

  "monitor": {
    "_description": "Org monitoring and alerting configuration",
    "refreshInterval": 30000,
    "alertCooldownMinutes": 15,
    "maxHistoryDays": 90,
    "alerts": [
      {
        "name": "API Usage High",
        "metric": "apiUsagePercent",
        "threshold": 80,
        "operator": "gte",
        "severity": "warning"
      },
      {
        "name": "Storage Near Limit",
        "metric": "storageUsagePercent",
        "threshold": 90,
        "operator": "gte",
        "severity": "critical"
      }
    ]
  },

  "reporting": {
    "_description": "Report generation settings",
    "defaultFormat": "html",
    "includeCharts": true,
    "autoOpenReport": true,
    "outputDirectory": "./reports"
  },

  "plugins": {
    "_description": "Plugin configuration. Plugins are loaded from .sandforge/plugins/",
    "directory": ".sandforge/plugins",
    "autoLoad": true,
    "enabled": [
      "sandforge-anonymizer",
      "sandforge-custom-export"
    ]
  }
}
